{
  "name": "skyroads-hd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "An HD remake of SkyRoads (BlueMoon Software, 1993) with a 1:1 deterministic simulation.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dump": "tsx tools/dump-level.ts",
    "replay": "tsx tools/replay-demo.ts",
    "verify:electron-server": "node tools/verify-electron-server.cjs",
    "verify:acquire": "node tools/verify-acquire.cjs",
    "electron": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "sirv": "^3.0.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
